# Accessible from the VPS itself only. Set another bind host only with firewall rules.
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_HOST_PORT=8001

# Use different, strong values on the VPS; never commit the real .env.
SHARD_A_DB_PASSWORD=replace-with-strong-password-a
SHARD_B_DB_PASSWORD=replace-with-strong-password-b
